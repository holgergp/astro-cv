{
  "name": "astro-paper-cv",
  "version": "4.2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "typecheck": "astro check && tsc --noEmit",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "cz": "cz",
    "prepare": "husky install",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:container": "./scripts/playwright-container.sh",
    "test:e2e:update-screenshots": "./scripts/playwright-container.sh tests/pages.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.0",
    "astro-eslint-parser": "3.2.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro}": [
      "prettier --write"
    ]
  }
}
