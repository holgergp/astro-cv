{
  "name": "astro-paper-cv",
  "version": "4.2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "cz": "cz",
    "prepare": "husky install",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:percy": "percy exec -- playwright test"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/rss": "4.0.19",
    "@radix-ui/react-collapsible": "1.2.1",
    "@resvg/resvg-js": "2.6.2",
    "astro": "6.4.8",
    "fuse.js": "7.5.0",
    "github-slugger": "2.0.0",
    "remark-collapse": "0.1.2",
    "remark-toc": "9.0.0",
    "satori": "0.63.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.4",
    "@divriots/jampack": "0.34.2",
    "@eslint/js": "9.39.5",
    "@percy/cli": "1.32.12",
    "@percy/playwright": "1.1.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/github-slugger": "2.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "8.72.0",
    "astro-eslint-parser": "1.4.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  }
}
